<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>

  <Color x:Key="BackgroundColor">#FFFFFF</Color>
  <Color x:Key="BackgroundColorPointerOver">#EAF7F6</Color>
  <Color x:Key="BackgroundColorPressed">#D5F0ED</Color>
  <Color x:Key="BackgroundColorDisabled">#EFF2F6</Color>

  <Color x:Key="ForegroundColor">#3D4663</Color>
  <Color x:Key="ForegroundColorPointerOver">#20263B</Color>
  <Color x:Key="ForegroundColorPressed">#101427</Color>
  <Color x:Key="ForegroundColorDisabled">#9AA4BA</Color>

  <Color x:Key="BorderColor">#C3CCDA</Color>
  <Color x:Key="BorderColorPointerOver">#8E9BB4</Color>

  <Color x:Key="SystemAccentColor">#22C3B4</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#7EE4DA</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#17A398</Color>

  <Color x:Key="NeutralAccentColor">#AAB6CB</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#7B889F</Color>
  <Color x:Key="AccentColor1">#22C3B4</Color>
  <Color x:Key="AccentColor2">#17A398</Color>
  <Color x:Key="AccentColor3">#0E8C82</Color>

  <Color x:Key="TickLineColor">#DCE3EC</Color>
  <Color x:Key="BarNumberColor">#8A96AC</Color>
  <Color x:Key="FinalPitchColor">#C4CCDB</Color>
  <Color x:Key="TrackBackgroundAltColor">#F4F7FB</Color>

  <Color x:Key="WarningColor">#FFF4CE</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">Transparent</Color>
  <Color x:Key="WhiteKeyColorRight">Transparent</Color>
  <Color x:Key="WhiteKeyNameColor">#22C3B4</Color>

  <Color x:Key="CenterKeyColorLeft">#DFF6F3</Color>
  <Color x:Key="CenterKeyColorRight">#C9F0EB</Color>
  <Color x:Key="CenterKeyNameColor">#17A398</Color>

  <Color x:Key="BlackKeyColorLeft">#6E7A93</Color>
  <Color x:Key="BlackKeyColorRight">#3D4663</Color>
  <Color x:Key="BlackKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
