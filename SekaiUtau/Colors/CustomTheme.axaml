<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">True</system:Boolean>

  <Color x:Key="BackgroundColor">#1B1B1B</Color>
  <Color x:Key="BackgroundColorPointerOver">#262626</Color>
  <Color x:Key="BackgroundColorPressed">#303030</Color>
  <Color x:Key="BackgroundColorDisabled">#232323</Color>

  <Color x:Key="ForegroundColor">#D4D4D4</Color>
  <Color x:Key="ForegroundColorPointerOver">#FFFFFF</Color>
  <Color x:Key="ForegroundColorPressed">#FFFFFF</Color>
  <Color x:Key="ForegroundColorDisabled">#6B6B6B</Color>

  <Color x:Key="BorderColor">#343434</Color>
  <Color x:Key="BorderColorPointerOver">#4C4C4C</Color>

  <Color x:Key="SystemAccentColor">#8CC63F</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#A6DC5B</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#6FA32F</Color>

  <Color x:Key="NeutralAccentColor">#4C4C4C</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#666666</Color>
  <Color x:Key="AccentColor1">#8CC63F</Color>
  <Color x:Key="AccentColor2">#A8D95A</Color>
  <Color x:Key="AccentColor3">#5E9E2A</Color>

  <Color x:Key="TickLineColor">#2B2B2B</Color>
  <Color x:Key="BarNumberColor">#7F7F7F</Color>
  <Color x:Key="FinalPitchColor">#5C5C5C</Color>
  <Color x:Key="TrackBackgroundAltColor">#222222</Color>

  <Color x:Key="WarningColor">#433519</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">Transparent</Color>
  <Color x:Key="WhiteKeyColorRight">Transparent</Color>
  <Color x:Key="WhiteKeyNameColor">#9C9C9C</Color>

  <Color x:Key="CenterKeyColorLeft">#2E2E2E</Color>
  <Color x:Key="CenterKeyColorRight">#3A3A3A</Color>
  <Color x:Key="CenterKeyNameColor">#8CC63F</Color>

  <Color x:Key="BlackKeyColorLeft">#141414</Color>
  <Color x:Key="BlackKeyColorRight">#0E0E0E</Color>
  <Color x:Key="BlackKeyNameColor">#C8C8C8</Color>
</ResourceDictionary>
