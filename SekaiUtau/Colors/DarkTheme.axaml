<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>

  <!-- Neutral DAW greys with a lime accent, like modern singing editors. -->
  <Color x:Key="BackgroundColor">#1B1C1F</Color>
  <Color x:Key="BackgroundColorPointerOver">#26282C</Color>
  <Color x:Key="BackgroundColorPressed">#31343A</Color>
  <Color x:Key="BackgroundColorDisabled">#212327</Color>

  <Color x:Key="ForegroundColor">#DCDEE2</Color>
  <Color x:Key="ForegroundColorPointerOver">#FFFFFF</Color>
  <Color x:Key="ForegroundColorPressed">#FFFFFF</Color>
  <Color x:Key="ForegroundColorDisabled">#74787F</Color>

  <Color x:Key="BorderColor">#303338</Color>
  <Color x:Key="BorderColorPointerOver">#464A51</Color>

  <Color x:Key="SystemAccentColor">#8CBF3E</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#A9D45C</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#6E9A2E</Color>

  <Color x:Key="NeutralAccentColor">#464A51</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#6C7178</Color>
  <Color x:Key="AccentColor1">#8CBF3E</Color>
  <Color x:Key="AccentColor2">#A9D45C</Color>
  <Color x:Key="AccentColor3">#5F8A28</Color>

  <Color x:Key="TickLineColor">#2E3136</Color>
  <Color x:Key="BarNumberColor">#8B9098</Color>
  <Color x:Key="FinalPitchColor">#CFD2D6</Color>
  <Color x:Key="TrackBackgroundAltColor">#202226</Color>

  <Color x:Key="WarningColor">#4A3A14</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">#C6C9CE</Color>
  <Color x:Key="WhiteKeyColorRight">#E4E6E9</Color>
  <Color x:Key="WhiteKeyNameColor">#2A2C30</Color>

  <Color x:Key="CenterKeyColorLeft">#8CBF3E</Color>
  <Color x:Key="CenterKeyColorRight">#A9D45C</Color>
  <Color x:Key="CenterKeyNameColor">#1B1C1F</Color>

  <Color x:Key="BlackKeyColorLeft">#101113</Color>
  <Color x:Key="BlackKeyColorRight">#1C1E21</Color>
  <Color x:Key="BlackKeyNameColor">#DCDEE2</Color>
</ResourceDictionary>
