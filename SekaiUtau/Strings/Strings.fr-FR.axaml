  <system:String x:Key="voicebank.create.photo.choose">Choisir une photo...</system:String>
  <system:String x:Key="voicebank.create.photo.remove">Retirer</system:String>
  <system:String x:Key="voicebank.create.photo.none">Aucune photo</system:String>
  <system:String x:Key="voicebank.create.photo.invalid">Ce fichier n'est pas une image lisible.</system:String>
  <system:String x:Key="voicebank.create.folder">Dossier</system:String>
  <system:String x:Key="voicebank.create.ok">Créer</system:String>
  <system:String x:Key="voicebank.create.cancel">Annuler</system:String>
  <system:String x:Key="voicebank.create.needsname">Indiquez un nom pour la voix.</system:String>
