  <system:String x:Key="voicebank.create.title">Créer une voix</system:String>
  <system:String x:Key="voicebank.create.help">Crée un dossier de voix vide. Déposez-y vos WAV, réglez-les dans la fenêtre Voix, et la voix est utilisable tout de suite.</system:String>
