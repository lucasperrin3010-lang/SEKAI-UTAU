<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Mobile)' == 'true'">
    <TargetFramework>net10.0-android</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' And '$(Mobile)' != 'true' ">
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' And '$(Mobile)' != 'true' ">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType Condition="'$(Mobile)' != 'true'">WinExe</OutputType>
    <OutputType Condition="'$(Mobile)' == 'true'">Exe</OutputType>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.34</Version>
    <ApplicationIcon Condition="'$(Mobile)' != 'true'">Assets\sekai-utau.ico</ApplicationIcon>
    <PublishReadyToRun Condition="'$(Mobile)' != 'true'">true</PublishReadyToRun>
    <!-- Edition mobile : meme code, meme interface, mais application Android. -->
    <TreatWarningsAsErrors Condition="'$(Mobile)' == 'true'">false</TreatWarningsAsErrors>
    <ApplicationId Condition="'$(Mobile)' == 'true'">com.sekaiutau.mobile</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(Mobile)' == 'true'">1.0.28</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(Mobile)' == 'true'">28</ApplicationVersion>
    <AndroidPackageFormat Condition="'$(Mobile)' == 'true'">apk</AndroidPackageFormat>
    <SupportedOSPlatformVersion Condition="'$(Mobile)' == 'true'">23</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk Condition="'$(Mobile)' == 'true'">true</EmbedAssembliesIntoApk>
    <RunAOTCompilation Condition="'$(Mobile)' == 'true'">false</RunAOTCompilation>
    <DebugType>embedded</DebugType>
    <StartupObject />
  </PropertyGroup>
  <PropertyGroup>
    <CFBundleName>SEKAI UTAU</CFBundleName>
    <CFBundleDisplayName>SEKAI UTAU</CFBundleDisplayName>
    <CFBundleIdentifier>com.stakira.sekaiutau</CFBundleIdentifier>
    <CFBundleVersion>1.0.34</CFBundleVersion>
    <CFBundleShortVersionString>1.0.34</CFBundleShortVersionString>
    <CFBundlePackageType>APPL</CFBundlePackageType>
    <CFBundleSignature>????</CFBundleSignature>
    <CFBundleExecutable>SekaiUtau</CFBundleExecutable>
    <CFBundleIconFile>SekaiUtau.icns</CFBundleIconFile>
    <NSPrincipalClass>NSApplication</NSPrincipalClass>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <CFBundleDocumentTypes>
        <array>
            <dict>
                <key>CFBundleTypeName</key>
                <string>SekaiUtau Sequence File</string>
                <key>CFBundleTypeExtensions</key>
                <array>
                    <string>ustx</string>
                </array>
                <key>CFBundleTypeIconFile</key>
                <string>SekaiUtau.icns</string>
                <key>CFBundleTypeRole</key>
                <string>Editor</string>
                <key>LSItemContentTypes</key>
                <array>
                    <string>com.stakira.sekaiutau.ustx</string>
                </array>
            </dict>
        </array>          
  </CFBundleDocumentTypes>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Icone du fichier de projet .sekaiu, copiee a cote de l'executable pour l'association Windows. -->
    <None Include="Assets\sekaiu.ico" CopyToOutputDirectory="PreserveNewest" Link="sekaiu.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="DynamicData" Version="9.4.33" />
    <PackageReference Include="ReactiveUI" Version="24.2.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="3.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(Mobile)' != 'true'">
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
    <PackageReference Include="Dotnet.Bundle" Version="0.9.13" />
    <PackageReference Include="MonoMac.Core" Version="0.0.23728" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="2.2.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(Mobile)' == 'true'">
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
    <AndroidResource Include="Mobile\Resources\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(Mobile)' != 'true'">
    <Compile Remove="Mobile\**" />
    <None Remove="Mobile\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SekaiUtau.Core\SekaiUtau.Core.csproj" />
    <ProjectReference Include="..\SekaiUtau.Plugin.Builtin\SekaiUtau.Plugin.Builtin.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)'=='DEBUG'">
    <None Include="..\runtimes\**" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes\" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="..\runtimes\win-x64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <None Include="..\runtimes\win-arm64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <None Include="..\runtimes\osx\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <None Include="..\runtimes\linux-x64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
    <None Include="..\runtimes\linux-arm64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controls\NotePropertyExpression.axaml.cs">
      <DependentUpon>NotePropertyExpression.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\NotePropertiesControl.axaml.cs">
      <DependentUpon>NotePropertiesControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Resources\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\PasteParamDialog.axaml.cs">
      <DependentUpon>PasteParamDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\TrackSettingsDialog.axaml.cs">
      <DependentUpon>TrackSettingsDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\TrackColorDialog.axaml.cs">
      <DependentUpon>TrackColorDialog.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
    <PropertyGroup>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>
    <!-- This matches old behavior from .NET 8, should be removed when not needed -->
    <PropertyGroup>
        <NuGetAuditMode>direct</NuGetAuditMode>
    </PropertyGroup>
    <!-- Intercept references during compilation to alias System.Reactive -->
    <Target Name="AliasSystemReactive" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
        <ItemGroup>
            <ReferencePath Condition="'%(FileName)' == 'System.Reactive'">
                <Aliases>SystemReactiveHidden</Aliases>
            </ReferencePath>
        </ItemGroup>
    </Target>
    <PropertyGroup>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);MACOS</DefineConstants>
    </PropertyGroup>
</Project>
